use "vek"
use "vek/ast"
use "vek/isa"
use "vek/log"
use "vek/token"
use "std/conv"
use "std/unsafe"

// Parses vek source code and generates AST.
struct parser {
	logs:    []log::Log
	scanner: &token::Scanner
	tok:     token::Token
}

impl parser {
	// Advance to the next token.
	fn next(mut *self) {
		self.tok = self.scanner.Next()
		// Derive errors from the scanner.
		if self.tok.ID == token::ILLEGAL {
			self.logs = append(self.logs, self.scanner.Logs...)
			self.scanner.Logs = self.scanner.Logs[:0]
		}
	}

	fn tokPrec(*self): (int, int) {
		return self.tok.ID, self.tok.Precedence()
	}

	fn pushErr(mut *self, tok: token::Token, text: string) {
		self.logs = append(self.logs, log::Log{
			Kind:   log::Error,
			Column: tok.Column,
			Line:   tok.Line,
			Text:   text,
		})
	}

	fn errorExpected(mut *self, tok: token::Token, mut msg: string) {
		msg = "expected " + msg
		self.pushErr(tok, msg)
	}

	fn expect(mut *self, op: int) {
		if self.tok.ID != op {
			self.errorExpected(self.tok, "'"+token::String(op)+"'")
		}
		self.next() // make progress
	}

	fn parseLet(mut *self): ast::Let {
		self.next() // let
		name := self.tok
		self.expect(token::NAME) // function name
		if len(self.logs) > 0 {
			return nil
		}
		self.expect(token::LPAREN) // (
		if len(self.logs) > 0 {
			return nil
		}
		mut list := self.parseParamList() // parameters
		if len(self.logs) > 0 {
			return nil
		}
		self.expect(token::RPAREN) // )
		if len(self.logs) > 0 {
			return nil
		}
		self.expect(token::ASSIGN)
		if len(self.logs) > 0 {
			return nil
		}
		mut x := self.parseExpr()
		if x == nil {
			return nil
		}
		return &ast::Func{
			Name:   name,
			Params: list,
			X:      x,
		}
	}

	fn parseFuncCall(mut *self, name: token::Token): &ast::FuncCall {
		self.expect(token::LPAREN) // (
		if len(self.logs) > 0 {
			return nil
		}
		mut args := self.parseArgList() // arguments
		if len(self.logs) > 0 {
			return nil
		}
		self.expect(token::RPAREN) // )
		if len(self.logs) > 0 {
			return nil
		}
		return &ast::FuncCall{
			Name: name,
			Args: args,
		}
	}

	fn parseOperand(mut *self): ast::Expr {
		match self.tok.ID {
		| token::ILLEGAL:
			// Errors are derived from the scanner.
			return nil
		| token::NAME:
			tok := self.tok
			self.next()
			if self.tok.ID == token::LPAREN {
				mut func := self.parseFuncCall(tok)
				if func == nil {
					return nil
				}
				return func
			}
			return &ast::NameExpr{Token: tok, Name: tok.Kind}
		| token::INT:
			mut x := new(vek::Value)
			x.Type = vek::TypeIN
			mut _in := new(isa::Int)
			_ = _in.SetString(self.tok.Kind, 0)
			x.Data = _in
			self.next()
			return x
		| token::FLOAT:
			mut x := new(vek::Value)
			x.Type = vek::TypeFL
			let mut fl: isa::Float
			fl = conv::ParseFloat(self.tok.Kind, 64) else { use 0 }
			x.Data = fl
			self.next()
			return x
		| token::LPAREN:
			self.next()
			mut x := self.parseExpr()
			if x == nil {
				return nil
			}
			self.expect(token::RPAREN)
			return x
		|:
			self.errorExpected(self.tok, "operand")
			return nil
		}
	}

	fn parseUnaryExpr(mut *self): ast::Expr {
		match self.tok.ID {
		| token::ADD | token::SUB:
			tok := self.tok
			self.next()
			mut x := self.parseUnaryExpr()
			if x == nil {
				return nil
			}
			return &ast::UnaryExpr{Op: tok, X: x}
		|:
			return self.parseOperand()
		}
	}

	// Parses a (possibly) binary expression.
	// If x is non-nil, it is used as the left operand.
	fn parseBinaryExpr(mut *self, mut x: ast::Expr, prec1: int): ast::Expr {
		if x == nil {
			x = self.parseUnaryExpr()
			if x == nil {
				return nil
			}
		}
		for {
			op, oprec := self.tokPrec()
			if oprec < prec1 {
				return x
			}
			tok := self.tok
			self.expect(op)
			mut y := self.parseBinaryExpr(nil, oprec+1)
			if y == nil {
				return nil
			}
			x = &ast::BinaryExpr{X: x, Op: tok, Y: y}
		}
	}

	fn parseExpr(mut *self): ast::Expr {
		return self.parseBinaryExpr(nil, token::LowestPrec+1)
	}

	fn parseArgList(mut *self): (list: []ast::Expr) {
		if self.tok.ID == token::RPAREN {
			return
		}
		list = append(list, self.parseExpr())
		for self.tok.ID == token::COMMA && len(self.logs) == 0 {
			self.next()
			list = append(list, self.parseExpr())
		}

		return
	}

	fn parseParamList(mut *self): (list: []token::Token) {
		if self.tok.ID == token::RPAREN {
			return
		}
		list = append(list, self.tok)
		self.expect(token::NAME)
		for self.tok.ID == token::COMMA && len(self.logs) == 0 {
			self.next()
			list = append(list, self.tok)
			self.expect(token::NAME)
		}

		return
	}

	fn parse(mut *self): (ast: ast::Node) {
		match self.tok.ID {
		| token::LET:
			ast.Let = self.parseLet()
		|:
			ast.X = self.parseExpr()
		}
		return
	}
}

// Consumes the vek source code to perform lexical and syntactic
// analysis, ultimately generating an Abstract Syntax Tree (AST).
//
// The scanner is responsible for the lexical analysis of the source code.
// It automatically executes an initial Scanner.Next call prior
// to the start of the parsing process.
fn Parse(mut scanner: &token::Scanner): (ast::Node, []log::Log) {
	mut p := parser{
		scanner: scanner,
	}
	p.next() // Advance to the first token.
	if p.tok.ID == token::EOF {
		return ast::Node{}, nil
	}
	mut ast := p.parse()
	// Early return for error cases.
	if len(p.logs) > 0 {
		return ast, p.logs
	}
	// Check for EOF.
	// All expression must be consumed.
	if p.tok.ID != token::EOF {
		p.pushErr(p.tok, "invalid syntax")
	}
	return ast, p.logs
}