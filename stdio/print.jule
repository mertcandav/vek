use "std/bufio"
use "std/os"

// Default Writer for stdout.
let mut Stdout = bufio::Writer.New(os::Stdout())

let mut isPrint = true

// Reports whether the output will be printed to stdout.
fn IsPrint(): bool { return isPrint }

#disable nilptr
fn Print(s: string) {
	if isPrint {
		Stdout.WriteString(s) catch {}
	}
}

#disable nilptr
fn Println(s: string) {
	if isPrint {
		Print(s)
		Stdout.WriteByte('\n') catch {}
	}
}

#disable nilptr
fn Flush() {
	if isPrint {
		Stdout.Flush() catch {}
	}
}