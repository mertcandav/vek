use "vek/asm"
use "vek/isa"
use "std/conv"
use "std/strings"

// Special error values.
const (
	// Error message indicating success.
	_NoError = ""
)

// A virtual machine error.
struct Error {
	Opcode: isa::Opcode // The opcode.
	PC:     isa::PC     // The PC of the opcode.
	Error:  string      // The problem.
}

impl Error {
	fn String(*self): string {
		mut b := strings::Builder{}
		b.WriteString("instruction ")!
		b.WriteString(asm::PrintOP(self.Opcode))!
		b.WriteString("; PC ")!
		b.WriteString(conv::Itoa(self.PC))!
		b.WriteString(": ")!
		b.WriteString(self.Error)!
		return b.String()
	}
}